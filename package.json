{
  "name": "claude2ui",
  "productName": "Claude2UI",
  "version": "0.1.0",
  "description": "Mehrere Claude-CLI-Chats parallel in einem frei teilbaren Panel-Grid",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke": "electron-vite build && node scripts/smoke.mjs smoke-out",
    "postinstall": "node scripts/dev-branding.mjs"
  },
  "dependencies": {
    "@a2ui/react": "^0.15.0",
    "@a2ui/web_core": "^0.15.0",
    "highlight.js": "^11.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
